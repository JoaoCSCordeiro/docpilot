QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=docpilot

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=docpilot

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

RETRIEVAL_TOP_K=5
CONFIDENCE_THRESHOLD=0.5

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_CALLS_PER_MINUTE=20
GROQ_MAX_TOKENS=1024
GROQ_PRICE_INPUT_PER_MILLION=0.15
GROQ_PRICE_OUTPUT_PER_MILLION=0.60

API_HOST=0.0.0.0
API_PORT=8000

MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8001

# Optional: tracing is disabled unless both keys are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
