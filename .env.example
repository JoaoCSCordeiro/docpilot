QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=docpilot_v2

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=docpilot

EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
RERANKER_MODEL_NAME=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RETRIEVAL_MODE=hybrid
BM25_LANGUAGE=portuguese

RETRIEVAL_TOP_K=5
CONFIDENCE_THRESHOLD=0.1

# groq | azure_openai (the LLM-as-a-judge always runs on Groq)
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_CALLS_PER_MINUTE=20
GROQ_MAX_TOKENS=1024
GROQ_PRICE_INPUT_PER_MILLION=0.15
GROQ_PRICE_OUTPUT_PER_MILLION=0.60

# Only read when LLM_PROVIDER=azure_openai. The deployment name comes from infra/terraform-azure.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_MAX_CALLS_PER_MINUTE=10
AZURE_OPENAI_MAX_TOKENS=1024

# LLM-as-a-judge used by scripts/run_llm_evaluation.py
JUDGE_MODEL=openai/gpt-oss-20b
JUDGE_MAX_TOKENS=2048
# Empty = model default. none/low/medium/high are model-dependent on Groq.
JUDGE_REASONING_EFFORT=

# Shared LLM cache and Groq rate limiter (Redis). sqlite/memory keep the single-process
# behaviour; redis falls back to them when Redis is unreachable.
REDIS_URL=redis://localhost:6379/0
LLM_CACHE_BACKEND=sqlite
# 0 = never expire
LLM_CACHE_TTL_SECONDS=604800
RATE_LIMITER_BACKEND=memory

MAX_QUESTION_LENGTH=2000

API_HOST=0.0.0.0
API_PORT=8000

MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8001

# Optional: tracing is disabled unless both keys are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
