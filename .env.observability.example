# Secrets for docker-compose.observability.yml (local Langfuse). Copy to
# .env.observability and replace every value; generate random values with
# python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=change-me
CLICKHOUSE_PASSWORD=change-me
MINIO_ROOT_PASSWORD=change-me
REDIS_AUTH=change-me
SALT=change-me
NEXTAUTH_SECRET=change-me
# 64 hex characters (32 bytes)
ENCRYPTION_KEY=change-me

LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-change-me
LANGFUSE_INIT_USER_EMAIL=admin@docpilot.local
LANGFUSE_INIT_USER_NAME=docpilot
LANGFUSE_INIT_USER_PASSWORD=change-me
